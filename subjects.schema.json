{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/static-subject-management/subjects.schema.json",
  "title": "Subject Management Schedule",
  "type": "object",
  "required": ["last_updated", "semester_groups"],
  "properties": {
    "last_updated": { "type": "string", "format": "date" },
    "semester_groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/semesterGroup" }
    }
  },
  "$defs": {
    "semesterGroup": {
      "type": "object",
      "required": ["semester", "subjects"],
      "properties": {
        "active": { "type": "boolean", "default": false },
        "semester": { "type": "string", "minLength": 1 },
        "show_groups": { "type": "boolean", "default": true },
        "show_index_feature": { "type": "boolean", "default": false },
        "featured_subject_id": { "type": "string" },
        "subjects": {
          "type": "array",
          "items": { "$ref": "#/$defs/subject" }
        }
      },
      "additionalProperties": true
    },
    "subject": {
      "type": "object",
      "required": ["id", "code", "description", "day", "time_start", "time_end"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "day": { "type": "string", "enum": ["M", "T", "W", "TH", "F", "S", "SU"] },
        "time_start": { "type": "string", "pattern": "^\\d{1,2}(:\\d{2})?(\\s?(AM|PM|am|pm))?$" },
        "time_start_is_am": { "type": "boolean" },
        "time_end": { "type": "string", "pattern": "^\\d{1,2}(:\\d{2})?(\\s?(AM|PM|am|pm))?$" },
        "time_end_is_am": { "type": "boolean" },
        "room": { "type": "string" },
        "instructor": { "type": "string" },
        "units": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    }
  }
}
